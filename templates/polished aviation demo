function placeBet() {
    const stake = document.getElementById("stake").value;
    const message = document.getElementById("message");

    // Empty input
    if (stake === "") {
        message.textContent = "Please enter an amount.";
        return;
    }

    // Convert to number
    const amount = Number(stake);

    // Check valid number
    if (isNaN(amount)) {
        message.textContent = "Amount must be a number.";
        return;
    }

    // Minimum amount
    if (amount < 3) {
        message.textContent = "Minimum amount is 3.";
        return;
    }

    // Maximum amount example
    if (amount > 10000) {
        message.textContent = "Amount is too large.";
        return;
    }

    message.textContent = `Accepted: ${amount}`;
}
